{
  "name": "codeblueprint",
  "version": "1.0.0",
  "description": "CLI tool for structural analysis of JavaScript/TypeScript/React/Next.js codebases",
  "license": "MIT",
  "author": "Phellep Shapopi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sphellep04/codeblueprint.git"
  },
  "homepage": "https://github.com/Sphellep04/codeblueprint#readme",
  "bugs": {
    "url": "https://github.com/Sphellep04/codeblueprint/issues"
  },
  "keywords": [
    "cli",
    "codebase-analysis",
    "dependency-graph",
    "static-analysis",
    "typescript",
    "react",
    "nextjs"
  ],
  "bin": {
    "codeblueprint": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:web && node scripts/copy-ui.js",
    "build:web": "npm run build --workspace=web",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --require ts-node/register --test test/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^12.0.0",
    "ignore": "^5.3.0",
    "ts-morph": "^23.0.0",
    "typescript": "^5.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0"
  }
}
