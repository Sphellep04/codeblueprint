{
  "name": "codeatlas",
  "version": "0.1.0",
  "description": "CLI tool for structural analysis of JavaScript/TypeScript/React/Next.js codebases",
  "private": true,
  "bin": {
    "codeatlas": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --require ts-node/register --test test/*.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "ignore": "^5.3.0",
    "ts-morph": "^23.0.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0"
  }
}
